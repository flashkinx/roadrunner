{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roadrunner",
  "version": "0.1.0",
  "identifier": "io.github.flashkinx.roadrunner",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "mini",
        "url": "mini.html",
        "title": "Roadrunner",
        "width": 100,
        "height": 30,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false,
        "windowEffects": { "effects": ["popover"], "state": "active", "radius": 15 }
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Roadrunner",
        "width": 800,
        "height": 580,
        "minWidth": 700,
        "minHeight": 500,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" }
  }
}
